# Primary OpenRouter keys used by the MornAI AI router.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_API_KEY_1="YOUR_OPENROUTER_API_KEY_1"
# Optional per-model keys. When omitted, the generic OpenRouter keys above are used.
OPENROUTER_API_KEY_GEMMA="YOUR_OPENROUTER_API_KEY_GEMMA"
OPENROUTER_API_KEY_NEMOTRON_SUPER="YOUR_OPENROUTER_API_KEY_NEMOTRON_SUPER"
OPENROUTER_API_KEY_NEMOTRON_ULTRA="YOUR_OPENROUTER_API_KEY_NEMOTRON_ULTRA"
# Keep false for OpenRouter's zero-cost :free model variants. Set true only after adding credits.
MORNAI_USE_PAID_MODELS="false"
MORNAI_APP_URL="https://your-production-domain.example"
# Public URL of the Render web service that runs server.ts, e.g. https://your-service.onrender.com
VITE_MORNAI_API_URL="https://your-render-service.onrender.com"
# Optional comma-separated browser origins allowed by the Render API. "*" allows all non-credentialed browser requests.
CORS_ALLOWED_ORIGINS="*"

# Optional Gemini fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Configuration
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-..."

# Optional Firebase App Check (reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY="YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY"
