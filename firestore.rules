rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function startupExists(startupId) { return exists(/databases/$(database)/documents/startups/$(startupId)); }
    function isFounder(startupId) { return signedIn() && startupExists(startupId) && get(/databases/$(database)/documents/startups/$(startupId)).data.founderId == request.auth.uid; }
    function isMember(startupId) { return signedIn() && startupExists(startupId) && (isFounder(startupId) || (request.auth.uid in get(/databases/$(database)/documents/startups/$(startupId)).data.get('memberIds', [])) || exists(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid))); }
    function isParticipant(data) { return signedIn() && data.participants is list && request.auth.uid in data.participants; }

    match /users/{userId} { allow read, create, update, delete: if isUser(userId); match /preferences/{preferenceId} { allow read, create, update, delete: if isUser(userId); } match /startupContexts/{startupId} { allow read, delete: if isUser(userId); allow create, update: if isUser(userId) && request.resource.data.userId == userId; } }
    match /publicProfiles/{userId} { allow read: if signedIn(); allow create, update, delete: if isUser(userId); }

    match /connections/{connectionId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid && request.resource.data.toUserId is string && request.resource.data.toUserId != request.auth.uid && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size() == 2 && request.resource.data.status == 'pending';
      allow update: if signedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid || isParticipant(resource.data)) && request.resource.data.fromUserId == resource.data.fromUserId && request.resource.data.toUserId == resource.data.toUserId && ((request.auth.uid == resource.data.toUserId && request.resource.data.status in ['accepted', 'declined']) || (request.auth.uid == resource.data.fromUserId && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }

    match /directChats/{roomId} {
      allow read: if signedIn() && (resource.data.participantAId == request.auth.uid || resource.data.participantBId == request.auth.uid || isParticipant(resource.data));
      allow create, update: if signedIn() && request.resource.data.roomId == roomId && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants && request.resource.data.participantAId is string && request.resource.data.participantBId is string && request.resource.data.participantAId != request.resource.data.participantBId;
      allow delete: if false;
    }

    match /messages/{messageId} {
      // Keep read authorization query-safe: private/startup listeners both
      // constrain participants, so access is proven directly from the queried
      // fields instead of relying on unrelated fallback fields or get() calls.
      allow read: if signedIn() && (
        (
          resource.data.roomType == 'world'
          && resource.data.roomId == 'world'
        )
        || (
          resource.data.participants is list
          && request.auth.uid in resource.data.participants
        )
      );

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomType in ['world', 'private', 'startup']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAtClient is number
        && (
          (
            request.resource.data.roomType == 'world'
            && request.resource.data.roomId == 'world'
          )
          ||
          (
            request.resource.data.roomType == 'private'
            && request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == 2
            && request.resource.data.recipientId is string
            && request.resource.data.recipientId in request.resource.data.participants
            && request.resource.data.recipientId != request.auth.uid
          )
          ||
          (
            request.resource.data.roomType == 'startup'
            && request.resource.data.startupId is string
            && request.resource.data.roomId == 'startup-chat-' + request.resource.data.startupId
            && request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants
            && isMember(request.resource.data.startupId)
          )
        );

      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants && request.resource.data.founderId is string && request.resource.data.talentId is string && request.auth.uid in [request.resource.data.founderId, request.resource.data.talentId];
      allow update: if signedIn() && (resource.data.founderId == request.auth.uid || resource.data.talentId == request.auth.uid || isParticipant(resource.data)) && request.resource.data.founderId == resource.data.founderId && request.resource.data.talentId == resource.data.talentId;
      allow delete: if false;
    }

    match /startupInterestRequests/{requestId} { allow create: if signedIn() && request.resource.data.talentId == request.auth.uid; allow read: if signedIn() && (resource.data.talentId == request.auth.uid || resource.data.founderId == request.auth.uid); allow update: if signedIn() && resource.data.founderId == request.auth.uid; allow delete: if false; }
    match /startupListings/{startupId} { allow read: if signedIn(); allow create, update: if isFounder(startupId); allow delete: if isFounder(startupId); }
    match /startupChats/{startupId} { allow read: if isMember(startupId); allow create, update: if isFounder(startupId); allow delete: if isFounder(startupId); }
    match /startups/{startupId} { allow read: if isMember(startupId); allow create: if signedIn() && request.resource.data.founderId == request.auth.uid; allow update, delete: if isFounder(startupId); match /members/{memberId} { allow read: if isMember(startupId); allow create, update, delete: if isFounder(startupId); } match /roles/{roleId} { allow read: if signedIn(); allow create, update, delete: if isFounder(startupId); } match /tasks/{taskId} { allow read: if isMember(startupId); allow create, update: if isMember(startupId); allow delete: if isFounder(startupId); } match /historyLogs/{logId} { allow read: if isMember(startupId); allow create, update, delete: if isFounder(startupId); } match /activityLogs/{logId} { allow read: if isMember(startupId); allow create: if isMember(startupId); allow update, delete: if false; } match /privateChats/{memberId}/messages/{messageId} { allow read: if isMember(startupId); allow create, update, delete: if false; } }
    match /videoCalls/{callId} { allow read: if isParticipant(resource.data); allow create, update: if isParticipant(request.resource.data); allow delete: if isParticipant(resource.data); }
    match /worldChat/messages/{messageId} { allow read, create: if signedIn(); allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
