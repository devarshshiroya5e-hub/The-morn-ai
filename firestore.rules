rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFounder(startupId) {
      return signedIn()
        && get(/databases/$(database)/documents/startups/$(startupId)).data.founderId == request.auth.uid;
    }

    function isMember(startupId) {
      return signedIn()
        && (
          isFounder(startupId)
          ||
          exists(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid))
        );
    }

    function isActiveMember(startupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // ---------------------------------------------------------
    // USER PROFILE
    // ---------------------------------------------------------

    match /users/{userId} {
      allow read, create, update, delete: if isUser(userId);

      // One independent context per startup.
      // A founder can own startup A and be a worker in startup B
      // without overwriting the global user profile.
      match /startupContexts/{startupId} {
        allow read: if isUser(userId);

        allow create, update: if
          isUser(userId)
          && exists(/databases/$(database)/documents/startups/$(startupId))
          && request.resource.data.userId == userId
          && request.resource.data.startupId == startupId
          && (
            (
              request.resource.data.role == 'founder'
              && get(/databases/$(database)/documents/startups/$(startupId)).data.founderId == userId
            )
            ||
            (
              request.resource.data.role == 'employee'
              && exists(/databases/$(database)/documents/startups/$(startupId)/members/$(userId))
            )
          );

        allow delete: if isUser(userId);
      }
    }



    // ---------------------------------------------------------
    // GLOBAL WORLD CHAT
    // Every authenticated MornAI member can read and send messages.
    // ---------------------------------------------------------

    match /worldChat/messages/{messageId} {
      allow read: if signedIn();

      allow create: if
        signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() <= 128
        && request.resource.data.createdAtClient is number
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 120;

      allow update, delete: if
        signedIn()
        && resource.data.senderId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // STARTUPS
    // ---------------------------------------------------------

    match /startups/{startupId} {
      allow read: if signedIn();

      // A user can only create a startup for themselves.
      allow create: if
        signedIn()
        && request.resource.data.founderId == request.auth.uid;

      // Only the founder can edit the startup.
      // Founder ownership cannot be transferred accidentally.
      allow update: if
        signedIn()
        && resource.data.founderId == request.auth.uid
        && request.resource.data.founderId == resource.data.founderId;

      allow delete: if
        signedIn()
        && resource.data.founderId == request.auth.uid;

      // -------------------------------------------------------
      // STARTUP MEMBERS
      // -------------------------------------------------------

      match /members/{memberId} {
        allow read: if isMember(startupId);

        // Founder can add/manage members.
        allow create: if
          isFounder(startupId)
          && request.resource.data.userId == memberId
          && request.resource.data.startupId == startupId;

        allow update: if
          isFounder(startupId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.startupId == resource.data.startupId;

        allow delete: if isFounder(startupId);
      }


      // -------------------------------------------------------
      // PRIVATE STARTUP CHAT
      // Only the startup founder and officially selected/active
      // members can access the conversation with that startup.
      // -------------------------------------------------------

      match /privateChats/{memberId}/messages/{messageId} {
        allow read: if
          isFounder(startupId)
          ||
          (
            signedIn()
            && request.auth.uid == memberId
            && isActiveMember(startupId)
          );

        allow create: if
          (
            isFounder(startupId)
            ||
            (
              signedIn()
              && request.auth.uid == memberId
              && isActiveMember(startupId)
            )
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.startupId == startupId
          && request.resource.data.recipientId == memberId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() <= 128
          && request.resource.data.createdAtClient is number
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120;

        allow update, delete: if
          signedIn()
          && resource.data.senderId == request.auth.uid
          && (
            isFounder(startupId)
            ||
            (
              request.auth.uid == memberId
              && isActiveMember(startupId)
            )
          );
      }

      // -------------------------------------------------------
      // OPEN ROLES
      // -------------------------------------------------------

      match /roles/{roleId} {
        allow read: if signedIn();
        allow create, update, delete: if isFounder(startupId);
      }

      // -------------------------------------------------------
      // TASKS
      // -------------------------------------------------------

      match /tasks/{taskId} {
        allow read: if isMember(startupId);

        allow create: if
          isFounder(startupId)
          ||
          (
            isMember(startupId)
            && request.resource.data.startupId == startupId
            && request.resource.data.assigneeId == request.auth.uid
          );

        allow update: if
          isFounder(startupId)
          ||
          (
            isMember(startupId)
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.startupId == startupId
            && request.resource.data.assigneeId == request.auth.uid
          );

        allow delete: if isFounder(startupId);
      }

      // -------------------------------------------------------
      // AI MEMORY / HISTORY
      // -------------------------------------------------------

      match /historyLogs/{logId} {
        allow read: if isMember(startupId);
        allow create, update, delete: if isFounder(startupId);
      }

      // -------------------------------------------------------
      // APPOINTMENTS / SYNC REQUESTS
      // -------------------------------------------------------

      match /appointments/{appointmentId} {
        allow read: if
          isFounder(startupId)
          ||
          (
            signedIn()
            && resource.data.talentId == request.auth.uid
          );

        allow create: if
          signedIn()
          && request.resource.data.startupId == startupId
          && request.resource.data.talentId == request.auth.uid;

        allow update: if
          (
            isFounder(startupId)
            ||
            (
              signedIn()
              && resource.data.talentId == request.auth.uid
            )
          )
          && request.resource.data.startupId == startupId
          && request.resource.data.founderId == resource.data.founderId
          && request.resource.data.talentId == resource.data.talentId;

        allow delete: if
          isFounder(startupId)
          ||
          (
            signedIn()
            && resource.data.talentId == request.auth.uid
          );
      }

      // -------------------------------------------------------
      // IMMUTABLE ACTIVITY HISTORY
      // -------------------------------------------------------

      match /activityLogs/{logId} {
        allow read: if isMember(startupId);

        allow create: if
          isMember(startupId)
          && request.resource.data.startupId == startupId
          && request.resource.data.actorId == request.auth.uid;

        allow update, delete: if false;
      }
    }
  }
}
