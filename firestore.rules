rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function startupExists(startupId) {
      return exists(/databases/$(database)/documents/startups/$(startupId));
    }

    function isFounder(startupId) {
      return signedIn()
        && startupExists(startupId)
        && get(/databases/$(database)/documents/startups/$(startupId)).data.founderId == request.auth.uid;
    }

    function isMember(startupId) {
      return signedIn()
        && (
          isFounder(startupId)
          ||
          exists(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid))
        );
    }

    function isActiveMember(startupId) {
      return signedIn()
        && startupExists(startupId)
        && (
          (
            exists(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid)).data.status == 'active'
          )
          ||
          request.auth.uid in get(/databases/$(database)/documents/startups/$(startupId)).data.get('memberIds', [])
        );
    }

    function isActiveMemberForUser(startupId, userId) {
      return
        startupExists(startupId)
        && (
          (
            exists(/databases/$(database)/documents/startups/$(startupId)/members/$(userId))
            && get(/databases/$(database)/documents/startups/$(startupId)/members/$(userId)).data.status == 'active'
          )
          ||
          userId in get(/databases/$(database)/documents/startups/$(startupId)).data.get('memberIds', [])
        );
    }

    // ---------------------------------------------------------
    // GLOBAL USER PROFILE
    // ---------------------------------------------------------

    match /users/{userId} {
      allow read, create, update, delete: if isUser(userId);

      match /startupContexts/{startupId} {
        allow read: if isUser(userId);

        allow create, update: if
          isUser(userId)
          && startupExists(startupId)
          && request.resource.data.userId == userId
          && request.resource.data.startupId == startupId
          && (
            (
              request.resource.data.role == 'founder'
              && get(/databases/$(database)/documents/startups/$(startupId)).data.founderId == userId
            )
            ||
            (
              request.resource.data.role == 'employee'
              && exists(/databases/$(database)/documents/startups/$(startupId)/members/$(userId))
            )
          );

        allow delete: if isUser(userId);
      }

      // UI-only preferences can survive across devices without becoming
      // part of the authoritative profile fields.
      match /preferences/{preferenceId} {
        allow read, create, update, delete: if isUser(userId);
      }
    }

    // ---------------------------------------------------------
    // CENTRAL MESSAGE STORE
    // One collection for World Chat and every private conversation.
    // ---------------------------------------------------------

    match /messages/{messageId} {
      allow read: if
        signedIn()
        && (
          resource.data.roomType == 'world'
          ||
          (
            resource.data.roomType == 'private'
            && resource.data.participants is list
            && request.auth.uid in resource.data.participants
          )
        );

      allow create: if
        signedIn()
        && request.resource.data.roomId is string
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.clientId is string
        && request.resource.data.clientId.size() > 0
        && request.resource.data.clientId.size() <= 128
        && request.resource.data.createdAtClient is number
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.roomType == 'world'
            && request.resource.data.roomId == 'world'
          )
          ||
          (
            request.resource.data.roomType == 'private'
            && request.resource.data.startupId is string
            && startupExists(request.resource.data.startupId)
            && request.resource.data.recipientId is string
            && request.resource.data.participants is list
            && request.resource.data.participants.size() == 2
            && request.auth.uid in request.resource.data.participants
            && get(/databases/$(database)/documents/startups/$(request.resource.data.startupId)).data.founderId in request.resource.data.participants
            && request.resource.data.recipientId in request.resource.data.participants
            && request.resource.data.recipientId != request.auth.uid
            && (
              (
                isFounder(request.resource.data.startupId)
                && request.resource.data.recipientId != get(/databases/$(database)/documents/startups/$(request.resource.data.startupId)).data.founderId
                && isActiveMemberForUser(request.resource.data.startupId, request.resource.data.recipientId)
              )
              ||
              (
                isActiveMember(request.resource.data.startupId)
                && request.resource.data.recipientId == get(/databases/$(database)/documents/startups/$(request.resource.data.startupId)).data.founderId
              )
            )
          )
        );

      // Messages are immutable. Delivery state is UI state, not a database mutation.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // PUBLIC NETWORK PROFILES
    // Safe, non-sensitive fields mirrored for marketplace discovery.
    // Private account data remains under /users/{uid}.
    // ---------------------------------------------------------

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if
        isUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.name is string
        && request.resource.data.role in ['founder', 'employee'];
      allow delete: if isUser(userId);
    }

    // ---------------------------------------------------------
    // NETWORK CONNECTION REQUESTS
    // Two-sided relationship signal used by the startup marketplace.
    // ---------------------------------------------------------

    match /connections/{connectionId} {
      allow read: if
        signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if
        signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status == 'pending'
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() > 0
        && request.resource.data.toName is string
        && request.resource.data.toName.size() > 0
        && request.resource.data.createdAtClient is number;

      allow update: if
        signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && (
          (
            request.auth.uid == resource.data.toUserId
            && request.resource.data.status in ['accepted', 'declined']
          )
          ||
          (
            request.auth.uid == resource.data.fromUserId
            && request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // STARTUPS
    // ---------------------------------------------------------

    // Private startup records: only the founder or an active member may read them.
    match /startups/{startupId} {
      allow read: if isMember(startupId);

      allow create: if
        signedIn()
        && request.resource.data.founderId == request.auth.uid;

      allow update: if
        signedIn()
        && resource.data.founderId == request.auth.uid
        && request.resource.data.founderId == resource.data.founderId;

      allow delete: if
        signedIn()
        && resource.data.founderId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(startupId);

        allow create: if
          isFounder(startupId)
          && request.resource.data.userId == memberId
          && request.resource.data.startupId == startupId;

        allow update: if
          isFounder(startupId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.startupId == resource.data.startupId;

        allow delete: if isFounder(startupId);
      }

      match /roles/{roleId} {
        allow read: if signedIn();
        allow create, update, delete: if isFounder(startupId);
      }

      match /tasks/{taskId} {
        allow read: if isMember(startupId);

        allow create: if
          isFounder(startupId)
          ||
          (
            isMember(startupId)
            && request.resource.data.startupId == startupId
            && request.resource.data.assigneeId == request.auth.uid
          );

        allow update: if
          isFounder(startupId)
          ||
          (
            isMember(startupId)
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.startupId == startupId
            && request.resource.data.assigneeId == request.auth.uid
          );

        allow delete: if isFounder(startupId);
      }

      match /historyLogs/{logId} {
        allow read: if isMember(startupId);
        allow create, update, delete: if isFounder(startupId);
      }

      // Legacy path kept read-only so old records are not silently destroyed.
      // New appointments are stored in /appointments.
          // ---------------------------------------------------------
    // STARTUP INTEREST REQUESTS
    // Preview/demo startups use this lightweight request path.
    // ---------------------------------------------------------
    
    match /startupInterestRequests/{requestId} {
      allow create: if
        signedIn()
        && request.resource.data.talentId == request.auth.uid
        && request.resource.data.startupId is string
        && request.resource.data.startupName is string
        && request.resource.data.founderId is string
        && request.resource.data.founderName is string
        && request.resource.data.roleTitle is string
        && request.resource.data.roleTitle.size() > 0
        && request.resource.data.pitchMessage is string
        && request.resource.data.pitchMessage.size() <= 2000
        && request.resource.data.status == 'pending';

      allow read: if
        signedIn()
        && (
          resource.data.talentId == request.auth.uid
          || resource.data.founderId == request.auth.uid
        );

      allow update: if
        signedIn()
        && resource.data.founderId == request.auth.uid
        && request.resource.data.founderId == request.auth.uid;

      allow delete: if false;
    }

match /appointments/{appointmentId} {
        allow read: if isMember(startupId);
        allow create, update, delete: if false;
      }

      match /activityLogs/{logId} {
        allow read: if isMember(startupId);

        allow create: if
          isMember(startupId)
          && request.resource.data.startupId == startupId
          && request.resource.data.actorId == request.auth.uid;

        allow update, delete: if false;
      }

      // Legacy private chat path is read-only during migration.
      match /privateChats/{memberId}/messages/{messageId} {
        allow read: if
          isFounder(startupId)
          ||
          (
            signedIn()
            && request.auth.uid == memberId
            && isActiveMember(startupId)
          );

        allow create, update, delete: if false;
      }
    }

    // Legacy World Chat path is read-only during migration.
    match /worldChat/messages/{messageId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------
    // PUBLIC STARTUP LISTINGS
    // Discovery-safe startup metadata only. Sensitive history/tasks/team
    // records remain in /startups/{startupId} and are member-scoped.
    // ---------------------------------------------------------

    match /startupListings/{startupId} {
      allow read: if signedIn();

      allow create: if
        isFounder(startupId)
        && request.resource.data.id == startupId
        && request.resource.data.founderId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.openRoles is list;

      allow update: if
        isFounder(startupId)
        && request.resource.data.id == startupId
        && request.resource.data.founderId == request.auth.uid
        && request.resource.data.openRoles is list;

      allow delete: if isFounder(startupId);
    }

    // ---------------------------------------------------------
    // CENTRAL APPOINTMENTS
    // One appointment document is visible only to its two participants.
    // ---------------------------------------------------------

    match /appointments/{appointmentId} {
      allow read: if
        signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      allow create: if
        signedIn()
        && request.resource.data.startupId is string
        && exists(/databases/$(database)/documents/startupListings/$(request.resource.data.startupId))
        && request.resource.data.founderId is string
        && request.resource.data.talentId is string
        && request.resource.data.talentId == request.auth.uid
        && get(/databases/$(database)/documents/startupListings/$(request.resource.data.startupId)).data.founderId == request.resource.data.founderId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.founderId in request.resource.data.participants
        && request.resource.data.talentId in request.resource.data.participants
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status in ['confirmed', 'pending', 'completed', 'cancelled']
        && request.resource.data.roleTitle is string
        && request.resource.data.roleTitle.size() > 0
        && request.resource.data.roleTitle.size() <= 160
        && request.resource.data.date is string
        && request.resource.data.time is string;

      allow update: if
        signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.startupId == resource.data.startupId
        && request.resource.data.founderId == resource.data.founderId
        && request.resource.data.talentId == resource.data.talentId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.status in ['confirmed', 'pending', 'completed', 'cancelled'];

      allow delete: if
        signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }
  }
}
