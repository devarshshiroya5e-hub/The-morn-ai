rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function startupExists(startupId) {
      return exists(/databases/$(database)/documents/startups/$(startupId));
    }

    function isFounder(startupId) {
      return signedIn()
        && startupExists(startupId)
        && get(/databases/$(database)/documents/startups/$(startupId)).data.founderId == request.auth.uid;
    }

    function isMember(startupId) {
      return signedIn()
        && startupExists(startupId)
        && (
          isFounder(startupId)
          || request.auth.uid in get(/databases/$(database)/documents/startups/$(startupId)).data.get('memberIds', [])
          || exists(/databases/$(database)/documents/startups/$(startupId)/members/$(request.auth.uid))
        );
    }

    // Query-safe: works with where('participants', 'array-contains', request.auth.uid).
    // Do NOT add "participants is list" — that breaks list queries in Firestore.
    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participants;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isUser(userId);
      match /preferences/{preferenceId} {
        allow read, create, update, delete: if isUser(userId);
      }
      match /startupContexts/{startupId} {
        allow read, delete: if isUser(userId);
        allow create, update: if isUser(userId) && request.resource.data.userId == userId;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isUser(userId);
    }

    match /connections/{connectionId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.hasAll([request.resource.data.fromUserId, request.resource.data.toUserId])
        && request.resource.data.participants.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
          || isParticipant(resource.data))
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedAtClient'])
        && (
          (request.auth.uid == resource.data.toUserId && request.resource.data.status in ['accepted', 'declined'])
          || (request.auth.uid == resource.data.fromUserId && request.resource.data.status == 'cancelled')
        );
      allow delete: if false;
    }

    match /directChats/{roomId} {
      allow read: if signedIn()
        && (resource.data.participantAId == request.auth.uid
          || resource.data.participantBId == request.auth.uid
          || isParticipant(resource.data));
      allow create: if signedIn()
        && request.resource.data.roomId == roomId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantAId is string
        && request.resource.data.participantBId is string
        && request.resource.data.participantAId != request.resource.data.participantBId
        && request.resource.data.participants.hasAll([
          request.resource.data.participantAId,
          request.resource.data.participantBId
        ])
        && request.auth.uid in request.resource.data.participants;
      // Participants and identity fields must be immutable after room creation;
      // otherwise one participant could add an outsider to a private room.
      allow update: if signedIn()
        && (resource.data.participantAId == request.auth.uid
          || resource.data.participantBId == request.auth.uid
          || isParticipant(resource.data))
        && request.resource.data.roomId == roomId
        && request.resource.data.participantAId == resource.data.participantAId
        && request.resource.data.participantBId == resource.data.participantBId
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    match /messages/{messageId} {
      // World query: roomId == 'world' && roomType == 'world'
      // Private query: participants array-contains auth.uid
      allow read: if signedIn() && (
        (resource.data.roomType == 'world' && resource.data.roomId == 'world')
        || (
          request.auth.uid in resource.data.participants
          && (
            resource.data.roomType != 'startup'
            || (
              resource.data.startupId is string
              && isMember(resource.data.startupId)
            )
          )
        )
      );

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomType in ['world', 'private', 'startup']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAtClient is number
        && (
          (
            request.resource.data.roomType == 'world'
            && request.resource.data.roomId == 'world'
          )
          ||
          (
            request.resource.data.roomType == 'private'
            && request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == 2
            && request.resource.data.recipientId is string
            && request.resource.data.recipientId in request.resource.data.participants
            && request.resource.data.recipientId != request.auth.uid
          )
          ||
          (
            request.resource.data.roomType == 'startup'
            && request.resource.data.startupId is string
            && request.resource.data.roomId == 'startup-chat-' + request.resource.data.startupId
            && request.resource.data.participants is list
            && request.auth.uid in request.resource.data.participants
            && (
              isMember(request.resource.data.startupId)
              || (
                startupExists(request.resource.data.startupId)
                && get(/databases/$(database)/documents/startups/$(request.resource.data.startupId)).data.founderId == request.auth.uid
              )
            )
          )
        );

      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.founderId is string
        && request.resource.data.talentId is string
        && request.resource.data.startupId is string
        && request.resource.data.founderId != request.resource.data.talentId
        && request.resource.data.participants.hasAll([
          request.resource.data.founderId,
          request.resource.data.talentId
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.auth.uid in [request.resource.data.founderId, request.resource.data.talentId]
        && startupExists(request.resource.data.startupId)
        && get(/databases/$(database)/documents/startups/$(request.resource.data.startupId)).data.founderId == request.resource.data.founderId;
      allow update: if signedIn()
        && (resource.data.founderId == request.auth.uid
          || resource.data.talentId == request.auth.uid
          || isParticipant(resource.data))
        && request.resource.data.founderId == resource.data.founderId
        && request.resource.data.talentId == resource.data.talentId
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['confirmed', 'pending', 'completed', 'cancelled'];
      allow delete: if false;
    }

    match /startupInterestRequests/{requestId} {
      // These requests are created only by a contributor for a preview startup.
      // Keep the document's identity tied to that signed-in contributor and the
      // two people involved so requests cannot be forged for unrelated accounts.
      allow create: if signedIn()
        && request.resource.data.talentId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.founderId is string
        && request.resource.data.founderId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.resource.data.founderId,
          request.resource.data.talentId
        ])
        && request.resource.data.requestType == 'preview_interest';
      allow read: if signedIn()
        && (resource.data.talentId == request.auth.uid || resource.data.founderId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.founderId == request.auth.uid
        && request.resource.data.founderId == resource.data.founderId
        && request.resource.data.talentId == resource.data.talentId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.requestType == resource.data.requestType
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedAtClient']);
      allow delete: if false;
    }

    match /startupListings/{startupId} {
      allow read: if signedIn();
      allow create, update: if isFounder(startupId);
      allow delete: if isFounder(startupId);
    }

    match /startupChats/{startupId} {
      allow read: if isMember(startupId);
      allow create, update: if isFounder(startupId);
      allow delete: if isFounder(startupId);
    }

    match /startups/{startupId} {
      allow read: if isMember(startupId);
      allow create: if signedIn() && request.resource.data.founderId == request.auth.uid;
      allow update: if isFounder(startupId)
        && request.resource.data.founderId == resource.data.founderId;
      allow delete: if isFounder(startupId);

      match /members/{memberId} {
        allow read: if isMember(startupId);
        allow create, update, delete: if isFounder(startupId);
      }
      match /roles/{roleId} {
        allow read: if signedIn();
        allow create, update, delete: if isFounder(startupId);
      }
      match /tasks/{taskId} {
        allow read: if isMember(startupId);
        allow create, update: if isMember(startupId);
        allow delete: if isFounder(startupId);
      }
      match /historyLogs/{logId} {
        allow read: if isMember(startupId);
        allow create, update, delete: if isFounder(startupId);
      }
      match /activityLogs/{logId} {
        allow read: if isMember(startupId);
        allow create: if isMember(startupId);
        allow update, delete: if false;
      }
      match /privateChats/{memberId}/messages/{messageId} {
        allow read: if isMember(startupId);
        allow create, update, delete: if false;
      }
    }

    match /videoCalls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() > 1
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.callerId == request.auth.uid;
      // A participant may update call state, but cannot add another account to
      // the call or rewrite who initiated it after the initial invitation.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'joinedIds', 'updatedAt', 'endedBy', 'endedAt'
        ])
        && (
          (resource.data.status == 'ringing'
            && request.resource.data.status in ['ringing', 'active', 'rejected', 'ended'])
          || (resource.data.status == 'active'
            && request.resource.data.status in ['active', 'ended'])
        )
        && (
          !('endedBy' in request.resource.data)
          || request.resource.data.endedBy == request.auth.uid
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /sessions/{sessionId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants
          && request.resource.data.sessionId == sessionId
          && request.resource.data.offererId == request.auth.uid
          && request.resource.data.answererId is string
          && request.resource.data.answererId in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants
          && request.resource.data.answererId != request.auth.uid
          && request.resource.data.offer is map;

        allow update: if signedIn()
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.offererId == resource.data.offererId
          && request.resource.data.answererId == resource.data.answererId
          && (
            (request.auth.uid == resource.data.offererId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'updatedAt']))
            || (request.auth.uid == resource.data.answererId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'updatedAt']))
          );
        allow delete: if false;

        match /candidates/{candidateId} {
          allow read: if signedIn()
            && exists(/databases/$(database)/documents/videoCalls/$(callId))
            && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;
          allow create: if signedIn()
            && request.resource.data.senderId == request.auth.uid
            && exists(/databases/$(database)/documents/videoCalls/$(callId))
            && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;
          allow update, delete: if false;
        }
      }

      // Legacy 1:1 ICE paths (kept for older clients)
      match /callerCandidates/{candidateId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && exists(/databases/$(database)/documents/videoCalls/$(callId))
          && request.auth.uid in get(/databases/$(database)/documents/videoCalls/$(callId)).data.participants;
        allow update, delete: if false;
      }
    }

    match /worldChat/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
